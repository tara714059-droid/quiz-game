# =============================================
# 像素闖關王 - 環境變數設定範例
# 複製本檔案為 .env 並填入實際值
# =============================================

# Google Apps Script 部署後端連結
# 在 GAS 編輯器 > 部署 > 新增部署 > 網頁應用程式 中取得
VITE_GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 通關門檻：需答對幾題才算通過（預設 6）
VITE_PASS_THRESHOLD=6

# 每次遊戲的題目數量（預設 10）
VITE_QUESTION_COUNT=10
